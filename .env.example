# Server Environment
NODE_ENV=production

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=
VITE_APP_URL=

# JWT_SECRET: Secret key for signing authentication tokens (min 32 characters recommended).
JWT_SECRET=

# ADMIN_SECRET_KEY: Secret key required for Administrative operations and dashboard access.
ADMIN_SECRET_KEY=

# TRUST_PROXY: Reverse proxy trust level for Cloud Run / load balancers (e.g. 1).
TRUST_PROXY=1


